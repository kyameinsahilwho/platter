{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Platter",
  "version": "1.2.0",
  "identifier": "app.platter.disks",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Platter",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#EDEFEA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Platter",
    "copyright": "© 2026 Platter",
    "category": "Utility",
    "shortDescription": "See, clean, optimize and manage the disks on this PC",
    "longDescription": "Platter shows what is using space on your drives, cleans caches and leftovers Windows and your apps recreate, trims SSDs and defragments hard disks, and checks disk health.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
